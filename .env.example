# ─────────────────────────────────────────────────────────────
# EduAttend environment configuration
# Copy to `.env` and fill in values. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (PostgreSQL)
DATABASE_URL="postgresql://eduattend:eduattend@localhost:5432/eduattend?schema=public"
# Used by integration tests only — must point to a disposable database
TEST_DATABASE_URL="postgresql://eduattend:eduattend@localhost:5432/eduattend_test?schema=public"

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# 32-byte base64 key used to encrypt integration credentials (WhatsApp/SMS/email API keys) at rest
ENCRYPTION_KEY=""

# Email: "console" prints emails to the server log (development); "resend" sends them via resend.com
EMAIL_PROVIDER="console"
EMAIL_FROM="EduAttend <no-reply@example.com>"
EMAIL_API_KEY=""

# Object storage (provider: "local" writes to ./storage, "s3" for any S3-compatible service)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# WhatsApp Business Cloud API (platform defaults; organizations can store their own encrypted credentials)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# SMS: each school connects its own HTTPS gateway under Settings → Notifications (stored encrypted).

# Background jobs: required to call GET /api/cron (Authorization: Bearer <CRON_SECRET>).
# Alternatively run the worker process (npm run jobs:worker) and leave this empty.
CRON_SECRET=""

# ── Platform billing (manual: bank transfer / invoice) ──
# Shown to schools on Settings → Billing and on their invoices.
BILLING_PAYMENT_INSTRUCTIONS="Bank transfer to EduAttend (Pvt) Ltd · Meezan Bank · IBAN PK00 MEZN 0000 0000 0000 0000 · use your invoice number as the reference."
BILLING_CONTACT_EMAIL="billing@example.com"
# Grace period (days) after a trial ends or an invoice falls due before the school becomes read-only.
BILLING_GRACE_DAYS=7
